{
    "name": "@peppermint-digital/notifications",
    "version": "0.1.0",
    "description": "Benachrichtigungs-Oberflaeche zum gleichnamigen PHP-Paket: die Posteingangs-Ansicht, die Glocke und die Zuordnung von Symbol und Farbe — damit sie in jedem Produkt gleich aussehen.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepare": "npm run build"
    },
    "peerDependencies": {
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "jsdom": "^30.0.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0",
        "vitest": "^5.0.0"
    }
}
