{
    "name": "peppermint/notifications",
    "description": "Benachrichtigungs-Kern fuer Laravel — eine Meldung je Person, ein Vokabular je Produkt, Zustellung ueber Glocke und Web-Push. Zentral ueber AI Brain oder fuer sich allein.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "peppermint",
        "laravel",
        "notifications",
        "web-push",
        "ai-brain"
    ],
    "authors": [
        {
            "name": "Peppermint Digital",
            "email": "hello@peppermint-digital.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/mcp": "^0.1|^1.0"
    },
    "suggest": {
        "peppermint/ai-brain-bridge": "Zustellung und Web-Push zentral ueber AI Brain statt je Produkt.",
        "minishlink/web-push": "Nur fuer den eigenstaendigen Push-Betrieb — mit AI Brain haelt das Brain die VAPID-Schluessel.",
        "laravel/mcp": "Stellt die Benachrichtigungen als MCP-Werkzeuge bereit."
    },
    "autoload": {
        "psr-4": {
            "Peppermint\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Peppermint\\Notifications\\Tests\\": "tests/",
            "Peppermint\\Notifications\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Peppermint\\Notifications\\NotificationsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
